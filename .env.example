# From your app's "OAuth & Permissions" page (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-...
# From "Basic Information" -> App-Level Tokens, with the connections:write scope (starts with xapp-)
SLACK_APP_TOKEN=xapp-...

# Everything below is optional. Uncomment a line to change it. See docs/configuration.md.

# Channel to watch (name or ID)
# SNIPES_CHANNEL=ktsnipes
# Where the weekly and monthly reports go (default: the snipes channel)
# REPORT_CHANNEL=
# Report schedule. REPORT_TIME is 24-hour, in TIMEZONE.
# TIMEZONE=America/Detroit
# REPORT_DAY=sunday
# REPORT_TIME=20:00
# Also post a monthly report on the last day of each month at REPORT_TIME (0 = off)
# MONTHLY_REPORT=1
# Who posted reports ping: channel, here, or none
# REPORT_MENTION=channel
# Emoji the bot reacts with when it counts a snipe (e.g. dart). Off by default.
# CONFIRM_EMOJI=
# How often (minutes) and how far back (days) the bot re-reads the channel
# SWEEP_MINUTES=10
# SWEEP_DAYS=8
# Where the tally is stored. Defaults to snipes.db locally and /data/snipes.db in Docker.
# DB_PATH=snipes.db
# 1 = log the reports instead of posting them, and don't react to snipes
# DRY_RUN=0
