# From your app's "OAuth & Permissions" page (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-...
# From "Basic Information" -> App-Level Tokens, with the connections:write scope (starts with xapp-)
SLACK_APP_TOKEN=xapp-...

# Everything below is optional; these are the defaults.
SNIPES_CHANNEL=ktsnipes
# REPORT_CHANNEL=           # where the weekly report goes (default: the snipes channel)
TIMEZONE=America/Detroit
REPORT_DAY=sunday
REPORT_TIME=20:00           # 24-hour, in TIMEZONE
CONFIRM_EMOJI=dart          # bot reacts with this when it counts a snipe; blank to turn off
SWEEP_MINUTES=10            # how often it re-reads the channel for edits, deletions, and reactions
SWEEP_DAYS=8
DB_PATH=snipes.db           # on Railway this is /data/snipes.db (set in the Dockerfile)
DRY_RUN=false               # log the weekly report instead of posting it
